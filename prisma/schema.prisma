// Prisma schema for Shop POS System

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  password        String
  phone           String?
  role            String   @default("CASHIER")
  active          Boolean  @default(true)
  securityQuestion String?
  securityAnswer   String?
  // v2.10.6: Granular permissions stored as JSON string
  // Default values depend on role (admin gets all, manager gets most, cashier gets basic)
  permissions     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  sales           Sale[]
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  icon      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Vendor {
  id             String   @id @default(cuid())
  name           String
  companyName    String?
  phone          String?
  address        String?
  note           String?
  active         Boolean  @default(true)
  totalPurchased Float   @default(0)
  totalPaid      Float   @default(0)
  balance        Float   @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  products       Product[]
  purchases      VendorPurchase[]
}

model VendorPurchase {
  id          String   @id @default(cuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  amount      Float
  type        String   @default("PURCHASE") // PURCHASE | PAYMENT
  description String?
  paymentDate DateTime @default(now())
  createdAt   DateTime @default(now())
}

model Product {
  id              String   @id @default(cuid())
  name            String
  barcode         String   @unique
  barcodeType     String   @default("CODE128")
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  vendorId        String?
  vendor          Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  costPrice       Float    @default(0)
  salePrice       Float    @default(0)
  wholesalePrice  Float    @default(0)
  shopkeeperPrice Float    @default(0)
  unit            String   @default("piece")
  stock           Float    @default(0)
  storeStock      Float    @default(0)
  minStock        Float    @default(0)
  taxRate         Float    @default(0)
  expiryDate      DateTime?
  manufacturingDate DateTime?
  hasBarcode      Boolean  @default(true)
  image           String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  saleItems       SaleItem[]
  stockLogs       StockLog[]
  storeTxns       StoreTransaction[]
  // Box / Pack support: when a product is sold in boxes, these fields
  // link the box barcode to the piece product and define the relationship.
  packBarcode     String?                    // Barcode of the box (different from piece barcode)
  packQuantity    Float    @default(0)        // Number of pieces per box (e.g. 80)
  packPrice       Float    @default(0)        // Sale price of one box (regular retail)
  // ─── Industrial Barcode System (v2.8.0) ──────────────────────────────
  // productCode: Human-readable unique code (e.g. "RICE00120", "P000045")
  //   Generated by /api/barcode/product-code based on category.
  // barcodeSvg: Pre-rendered SVG string (crisp at any size, perfect for print).
  // barcodePng: Base64-encoded PNG (preview, mobile screens, verification).
  // barcodeVerified: Whether ZXing successfully decoded the PNG.
  // stickerSize: Default sticker size for this product (e.g. "50x30").
  // packingDate: When the product was packed (for loose items like rice/flour).
  // NOTE: barcodeType already exists above (line ~69)
  productCode     String?                    // e.g. "RICE00120"
  barcodeSvg      String?                    // Pre-rendered SVG
  barcodePng      String?                    // Base64 PNG (no data: prefix)
  barcodeVerified Boolean  @default(false)
  stickerSize     String   @default("50x30")
  packingDate     DateTime?
  // ─── Loose Product Support (v2.9.8) ──────────────────────────────────
  // inventorySource: "SHOP" (default, regular shop product) or "MAIN_STORE"
  //   (loose product whose stock is deducted from a linked Main Store product).
  // linkedStoreProductId: When inventorySource = "MAIN_STORE", this points to
  //   the StoreProduct ID in Main Store that holds the bulk stock.
  //   e.g. "Sugar (Loose)" links to StoreProduct "Sugar" (200 KG).
  // When sold in POS, the quantity is deducted from the linked StoreProduct
  // instead of the product's own stock field.
  inventorySource       String  @default("SHOP") // SHOP | MAIN_STORE
  linkedStoreProductId  String?                   // FK to StoreProduct (loose items)
}

model Sale {
  id            String     @id @default(cuid())
  invoiceNo     String     @unique
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  cardId        String?
  card          CustomerCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)
  customerName  String?
  customerPhone String?
  subtotal      Float      @default(0)
  taxTotal      Float      @default(0)
  discount      Float      @default(0)
  total         Float      @default(0)
  paidAmount    Float      @default(0)
  change        Float      @default(0)
  // v2.10.15: balanceDue — amount customer still owes (if paidAmount < total)
  balanceDue    Float      @default(0)
  paymentMethod String     @default("CASH")
  saleType      String     @default("RETAIL")
  status        String     @default("COMPLETED")
  originalSaleId String?
  note          String?
  createdAt     DateTime   @default(now())
  items         SaleItem[]
  returns       SaleReturn[]
}

model SaleReturn {
  id           String   @id @default(cuid())
  saleId       String
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  userId       String
  amount       Float
  reason       String?
  restocked    Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model SaleItem {
  id         String  @id @default(cuid())
  saleId     String
  sale       Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  name       String
  barcode    String
  price      Float
  costPrice  Float
  quantity   Float
  unit       String
  taxRate    Float
  lineTotal  Float
}

model StockLog {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      String
  quantity  Float
  note      String?
  createdAt DateTime @default(now())
}

model CustomerCard {
  id             String   @id @default(cuid())
  cardNumber     String   @unique
  customerId     String   @unique              // Unique Customer ID for future scalability (web/app integration)
  name           String
  phone          String?
  address        String?
  type           String   @default("REGULAR")
  balance        Float    @default(0)
  totalPurchases Float    @default(0)
  totalPaid      Float    @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  transactions   CardTransaction[]
  sales          Sale[]
}

model CardTransaction {
  id          String   @id @default(cuid())
  cardId      String
  card        CustomerCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  type        String    // DEPOSIT | WITHDRAWAL | PURCHASE | PAYMENT | CREDIT | DEBIT | ADJUSTMENT | REFUND
  amount      Float
  description String?
  saleId      String?
  operatorName String?  // Who processed this transaction
  note        String?
  createdAt   DateTime @default(now())
}

model StoreTransaction {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        String
  quantity    Float
  note        String?
  createdAt   DateTime @default(now())
}

model Expense {
  id          String   @id @default(cuid())
  title       String
  amount      Float
  category    String   @default("general") // rent | electricity | salary | supplies | transport | general
  note        String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}

// ---- Load & Bill Payment Module ----

model MobileLoadCompany {
  id            String   @id @default(cuid())
  name          String   @unique           // Jazz, Ufone, Telenor, Zong
  balance       Float    @default(0)       // Current stock balance (purchased - sold)
  totalPurchased Float   @default(0)       // Total amount loaded from company
  totalSold     Float    @default(0)       // Total amount sold to customers
  totalProfit   Float    @default(0)       // Total profit (sold - purchase cost)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  transactions  MobileLoadTxn[]
}

model MobileLoadTxn {
  id            String   @id @default(cuid())
  companyId     String
  company       MobileLoadCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type          String   @default("SALE")  // PURCHASE (buy from company) | SALE (sell to customer)
  amount        Float                         // Face value of load
  costPrice     Float    @default(0)          // Cost price (for purchase) or 0
  salePrice     Float    @default(0)          // Sale price to customer (for sale) or 0
  profit        Float    @default(0)          // salePrice - costPrice for SALE
  due           Float    @default(0)          // Remaining unpaid amount (if customer didn't pay full)
  customerPhone String?
  customerName  String?
  referenceNo   String?
  operatorName  String?
  note          String?
  createdAt     DateTime @default(now())
}

model BillPaymentTxn {
  id            String   @id @default(cuid())
  category      String                       // electricity | gas | water | internet | other
  consumerName  String?
  consumerPhone String?
  accountNo     String?                      // Bill reference / consumer ID
  billAmount    Float                        // Actual bill amount (liability to company)
  serviceCharge Float    @default(0)          // Service charge / commission (our income)
  totalPaid     Float                        // billAmount + serviceCharge (what customer should pay)
  amountReceived Float   @default(0)          // Amount actually received from customer
  due           Float    @default(0)          // Remaining unpaid amount
  referenceNo   String?
  operatorName  String?
  note          String?
  createdAt     DateTime @default(now())
}

model WalletTxn {
  id            String   @id @default(cuid())
  accountId     String?                      // Link to WalletAccount (null for legacy txns)
  provider      String                       // JAZZCASH | EASYPAISA | BANK
  type          String                       // SEND | RECEIVE
  amount        Float                        // Principal amount sent/received
  serviceCharge Float    @default(0)          // Editable service fee (profit)
  due           Float    @default(0)          // Remaining unpaid amount
  customerName  String?
  customerPhone String?
  referenceNo   String?
  operatorName  String?
  note          String?
  createdAt     DateTime @default(now())
}

// Multiple wallet accounts (JazzCash, Easypaisa, Bank)
model WalletAccount {
  id            String   @id @default(cuid())
  name          String                       // Account label (e.g. "JazzCash 03001234567")
  provider      String                       // JAZZCASH | EASYPAISA | BANK
  phoneNumber   String?                      // For JazzCash/Easypaisa
  accountNumber String?                      // For Bank
  balance       Float    @default(0)          // Current balance
  totalReceived Float    @default(0)          // Total received
  totalSent     Float    @default(0)          // Total sent
  totalCharges  Float    @default(0)          // Total service charges earned
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// SIM stock management (new SIMs + replacements)
model SimStock {
  id              String   @id @default(cuid())
  company         String                       // Jazz | Zong | Ufone | Telenor
  type            String                       // NEW | REPLACEMENT
  phoneNumber     String?                      // SIM phone number (if pre-allocated)
  costPrice       Float    @default(0)          // Purchase cost
  salePrice       Float    @default(0)          // Sale price to customer
  status          String   @default("IN_STOCK") // IN_STOCK | SOLD
  soldAt          DateTime?
  customerName    String?
  customerPhone   String?
  note            String?
  // Linked load company — when this SIM is sold, its costPrice is deducted
  // from the linked MobileLoadCompany's balance. This represents the
  // shopkeeper paying back the credit the company gave for the SIM.
  linkedCompanyId String?
  // Linked SIM (for replacement SIMs) — points to the original SIM's id
  // whose phone number is being replaced.
  linkedSimId     String?
  // ─── Deduction settings (v2.9.16) ──────────────────────────────────
  // How much to deduct from the linked load company when this SIM is sold.
  // deductionType: "FIXED" (fixed amount) or "PERCENTAGE" (% of costPrice)
  // deductionAmount: the fixed amount OR percentage value (e.g. 50 = Rs 50 fixed, or 10 = 10%)
  deductionType   String   @default("FIXED")   // FIXED | PERCENTAGE
  deductionAmount Float    @default(0)          // amount (Rs) or percentage (%)
  // Stock quantity — how many SIMs of this type are in stock
  // (allows bulk-adding multiple identical SIMs at once)
  stockQuantity   Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Settings {
  id            String   @id @default("shop")
  shopName      String   @default("My Shop")
  subName       String?
  logo          String?
  shopAddress   String?
  shopPhone     String?
  currency      String   @default("Rs")
  taxEnabled    Boolean  @default(false)
  defaultTax    Float    @default(0)
  receiptFooter String?
  invoicePrefix String   @default("INV")
  printerWidth  Int      @default(58)
  // v2.10.12: Default printer names for silent printing
  receiptPrinterName String?
  stickerPrinterName String?
  backupPasswordHash String?
  // Multi-computer sharing: "local" | "host" | "client"
  shareMode     String   @default("local")
  // When shareMode = "client", the network DB path (e.g. \\HOST\ShopPOS\pos.db)
  dbNetworkPath String?
  // Google Drive backup integration
  googleClientId     String?
  googleClientSecret String?
  googleRefreshToken String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Barcode & Sticker Settings (v2.9.0) ─────────────────────────────────────
// Stores all barcode/sticker/printer configuration. Per-user settings.
// Loaded automatically when POS starts and used by every sticker print.
model BarcodeSettings {
  id              String   @id @default("default")

  // SECTION 1: General
  defaultBarcodeType String @default("CODE128") // CODE128 | QR | EAN13
  autoGenerate      Boolean @default(true)
  autoVerify        Boolean @default(true)
  autoRegenerate    Boolean @default(true)
  humanReadable     Boolean @default(true)
  saveBarcodeImage  Boolean @default(true)
  saveBarcodeSvg    Boolean @default(true)

  // SECTION 2: Sticker
  stickerSize       String  @default("50x30") // 40x30 | 50x25 | 50x30 | 60x40 | custom
  customWidth       Float   @default(50)  // mm
  customHeight      Float   @default(30)  // mm
  labelGap          Float   @default(2)   // mm
  margin            Float   @default(1.5) // mm

  // SECTION 3: Printer
  printerType       String  @default("thermal203") // thermal203 | thermal300 | a4
  darkness          Int     @default(50)  // 0-100
  printSpeed        Int     @default(50)  // 0-100
  autoCut           Boolean @default(false)
  feedAfterPrint    Boolean @default(true)

  // SECTION 4: Sticker Design — which fields to show + order (JSON array)
  // Default order: storeLogo, storeName, productName, productCode, barcode,
  // barcodeNumber, sellingPrice, purchasePrice, weight, unit, packingDate,
  // expiryDate, batchNumber, manufacturingDate
  // Note: JSON stored as TEXT. Default set by application code if empty.
  stickerFields     String  @default("[]")

  // SECTION 5: Text Settings
  fontFamily        String  @default("Tahoma")
  fontSize          Int     @default(8)
  fontBold          Boolean @default(true)
  textAlign         String  @default("center") // left | center | right
  lineSpacing       Float   @default(1.1)
  textColor         String  @default("#000000")

  // SECTION 6: Barcode Settings
  barcodeWidth      Int     @default(2)     // module width in px
  barcodeHeight      Int     @default(40)    // bar height in px
  quietZone         Int     @default(4)     // mm
  barcodeTopMargin  Int     @default(0)     // mm
  barcodeBottomMargin Int   @default(0)     // mm
  centerBarcode     Boolean @default(true)
  highResSvg        Boolean @default(true)
  barcodePosition   String  @default("center")
  posScanBehavior   String  @default("ASK_QUANTITY")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Receipt Settings (v2.9.11) ─────────────────────────────────────────────
// Stores all receipt configuration. Similar to BarcodeSettings but for
// sale receipts (invoices). Loaded automatically and used by Receipt component.
model ReceiptSettings {
  id              String   @id @default("default")

  // SECTION 1: Receipt Size
  receiptSize       String  @default("58mm") // 58mm | 80mm | A4 | custom
  customWidth       Float   @default(58)  // mm (for custom)
  customHeight      Float   @default(0)   // mm (0 = auto/continuous)

  // SECTION 2: Layout
  layout            String  @default("left") // left | center | right
  showLogo          Boolean @default(true)
  showShopName      Boolean @default(true)
  showSubName       Boolean @default(true)
  showShopAddress   Boolean @default(true)
  showShopPhone     Boolean @default(true)
  showInvoiceNo     Boolean @default(true)
  showDateTime      Boolean @default(true)
  showCustomerName  Boolean @default(true)
  showCustomerPhone Boolean @default(false)
  showSaleType      Boolean @default(true)
  showPaymentMethod Boolean @default(true)
  showCardDetails   Boolean @default(true)
  showBarcode       Boolean @default(true)
  showFooter        Boolean @default(true)

  // SECTION 3: Font Settings
  fontFamily        String  @default("Consolas")
  fontSize          Int     @default(9)    // px
  fontBold          Boolean @default(true)
  headerFontSize    Int     @default(13)   // px (shop name)
  titleFontSize     Int     @default(11)   // px (section titles)

  // SECTION 4: Colors
  textColor         String  @default("#000000")
  headerColor       String  @default("#000000")

  // SECTION 5: Margins & Spacing
  marginTop         Float   @default(2)   // mm
  marginBottom      Float   @default(2)   // mm
  marginLeft        Float   @default(3)   // mm
  marginRight       Float   @default(1)   // mm
  lineSpacing       Float   @default(1.2)

  // SECTION 6: Content
  receiptFooter     String?               // Custom footer text
  showItemDetails   Boolean @default(true) // Show price × qty breakdown
  showSubtotal      Boolean @default(true)
  showTax           Boolean @default(true)
  showDiscount      Boolean @default(true)
  showChange        Boolean @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// v2.10.47: Product Load Requests — created in LoadBill menu, processed in POS
model ProductLoadRequest {
  id            String   @id @default(cuid())
  productName   String                       // e.g. "Jazz Load 100", "Ufone Load 50"
  customerName  String?
  customerPhone String?
  loadAmount    Float    @default(0)          // Face value of the load
  extraCharges  Float    @default(0)          // Service charge / commission (our income)
  totalAmount   Float    @default(0)          // loadAmount + extraCharges
  due           Float    @default(0)          // Remaining unpaid amount
  status        String   @default("PENDING")  // PENDING | COMPLETED | CANCELLED
  referenceNo   String?
  operatorName  String?
  note          String?
  processedAt   DateTime?
  processedBy   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
